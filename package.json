{
  "name": "defenestrator",
  "version": "1.0.1",
  "description": "Firefox extension to automatically organize tabs into tagged windows",
  "scripts": {
    "build": "node esbuild.config.js",
    "build:watch": "node esbuild.config.js --watch",
    "postbuild": "mkdir -p polyfill && cp node_modules/webextension-polyfill/dist/browser-polyfill.min.js polyfill/",
    "watch": "npm run build:watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "firefox",
    "extension",
    "tabs",
    "aerospace"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/webextension-polyfill": "^0.12.0",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.27.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "fp-ts": "^2.13.1",
    "webextension-polyfill": "^0.12.0"
  }
}
