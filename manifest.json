{
    "manifest_version": 3,
    "name": "Tab Defenestrator",
    "version": "1.2.0",
    "author": "Hannes Buseyne",
    "description": "Automatically route tabs into dedicated, themed windows based on URL rules. Keep your work, research, and personal browsing in separate windows — always.",
    "homepage_url": "https://github.com/hbuseyne/defenestrator",
    "permissions": [
        "tabs",
        "storage",
        "theme",
        "notifications"
    ],
    "icons": {
      "32": "icons/icon.svg"
    },
    "action": {
        "default_popup": "src/popup.html",
        "default_icon": {
            "32": "icons/icon.svg"
        },
        "default_title": "Defenestrator"
    },
    "commands": {
        "toggle-sticky": {
            "suggested_key": {
                "default": "Alt+Ctrl+T",
                "mac": "Alt+Command+T"
            },
            "description": "Toggle sticky for the current window"
        }
    },
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "scripts": ["dist/background.js"],
        "type": "module"
    },
    "options_ui": {
        "page": "src/options.html",
        "open_in_tab": true
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "defenestrator@hannesbuseyne.com",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": ["browsingActivity"],
                "optional": []
            }
        }
    }
}