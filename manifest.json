{
    "manifest_version": 3,
    "name": "Tab Defenestrator",
    "version": "1.1.6",
    "author": "Hannes Buseyne",
    "description": "Automatically organize tabs into themed tagged windows for AeroSpace.",
    "permissions": [
        "tabs",
        "storage",
        "theme"
    ],
    "icons": {
      "32": "icons/icon.svg"
    },
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "scripts": ["dist/background.js"],
        "type": "module"
    },
    "options_ui": {
        "page": "src/options.html",
        "open_in_tab": true
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "defenestrator@hannesbuseyne.com",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": ["browsingActivity"],
                "optional": []
            }
        }
    }
}