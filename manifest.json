{
    "manifest_version": 3,
    "name": "AeroSpace Tab Dispatcher",
    "version": "1.0.1",
    "description": "Automatically organize tabs into tagged windows for AeroSpace.",
    "permissions": [
        "tabs",
        "storage",
        "theme"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "scripts": ["dist/background.js"],
        "type": "module"
    },
    "options_ui": {
        "page": "src/options.html",
        "open_in_tab": true
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "aerospace-dispatcher@hannesbuseyne.com",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": ["browsingActivity"],
                "optional": []
            }
        }
    }
}