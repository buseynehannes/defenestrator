// CONFIGURATION: Define your tags and keywords here
const RULE_SETS = [
    { tag: "[DEV]",   match: ["github.com", "bitbucket.com"] },
    { tag: "[MEET]",  match: ["meet.google.com", "zoom.us"] },
    { tag: "[MAIL]",  match: ["mail.google.com", "outlook.office.com", "dpg-media.app.lumapps.com"] },
    { tag: "[CONFLUENCE]",  match: ["atlassian.dpgmedia.net/confluence"] },
    { tag: "[JIRA]",  match: ["atlassian.dpgmedia.net/jira"] }
    // NOTE: Everything else defaults to [RESEARCH] (see getTagForUrl below)
];

// DEFAULT TAG for everything else
const DEFAULT_TAG = "[RESEARCH]";

// --- STORAGE HELPERS (The fix for the "Amnesia" bug) ---

// Helper to set a window's tag in session storage + Firefox UI
async function setWindowTag(windowId, tag) {
    try {
        // 1. Tag the visual window title for AeroSpace
        await browser.windows.update(windowId, { titlePreface: tag });

        // 2. Persist this knowledge in session storage
        // We use a key prefix "win_" to avoid collisions
        let store = {};
        store[`win_${windowId}`] = tag;
        await browser.storage.session.set(store);

        console.log(`[TAG] Window ${windowId} tagged as ${tag}`);
    } catch (e) {
        console.error(`[TAG] Error setting tag for ${windowId}:`, e);
    }
}

// Helper to get a window's tag from session storage
async function getWindowTag(windowId) {
    try {
        const key = `win_${windowId}`;
        const result = await browser.storage.session.get(key);
        return result[key]; // Returns undefined if not found
    } catch (e) {
        console.error(`[TAG] Error getting tag for ${windowId}:`, e);
        return null;
    }
}

// Helper to determine tag from URL
function getTagForUrl(url) {
    if (!url || url.startsWith("about:") || url.startsWith("moz-extension:")) return null;
    for (const rule of RULE_SETS) {
        if (rule.match.some(keyword => url.includes(keyword))) {
            return rule.tag;
        }
    }
    return DEFAULT_TAG;
}

// --- CORE LOGIC ---

async function dispatchTab(tabId, url) {
    try {
        const targetTag = getTagForUrl(url);
        // Ignore internal pages or empty URLs
        if (!targetTag) return;

        console.log(`[DISPATCH] Processing: ${url} -> ${targetTag}`);

        const tab = await browser.tabs.get(tabId);
        const currentWindowId = tab.windowId;

        // 1. Get the current window's tag from storage
        let currentWindowTag = await getWindowTag(currentWindowId);

        // FALLBACK: If storage is empty (first run), try to guess the tag
        if (!currentWindowTag) {
            console.log(`[DISPATCH] Current window ${currentWindowId} has no tag in storage. assuming default or tagging now.`);
            // Only if we are moving TO default, we might assume we are IN default to prevent loops
            // But safer is to treat it as "Unknown" causing a move/create
        }

        // 2. CHECK: Are we already in the right place?
        if (currentWindowTag === targetTag) {
            console.log(`[DISPATCH] ✓ Tab already in correct window (${targetTag})`);
            return;
        }

        // 3. SEARCH: Find an existing window with this tag
        const allWindows = await browser.windows.getAll({});
        let targetWindow = null;

        for (const win of allWindows) {
            // Don't move to the window we are already in (unless we retagged it, but simple logic first)
            if (win.id === currentWindowId) continue;

            const winTag = await getWindowTag(win.id);
            if (winTag === targetTag) {
                targetWindow = win;
                break;
            }
        }

        if (targetWindow) {
            // CASE A: Move to existing window
            console.log(`[DISPATCH] >> Moving tab to existing window ${targetWindow.id} [${targetTag}]`);
            await browser.tabs.move(tabId, { windowId: targetWindow.id, index: -1 });
            await browser.windows.update(targetWindow.id, { focused: true });
            await browser.tabs.update(tabId, { active: true });
        } else {
            // CASE B: Create NEW window (Current window is wrong, and no target exists)

            // SPECIAL CHECK: If the current window has ONLY this new tab (and maybe a blank one),
            // instead of creating a NEW window, we should just RENAME (Retag) the current one.
            const currentTabs = await browser.tabs.query({ windowId: currentWindowId });
            const isWindowBasicallyEmpty = currentTabs.length <= 1 || (currentTabs.length === 2 && currentTabs.find(t => t.url === "about:blank"));

            if (isWindowBasicallyEmpty && !currentWindowTag) {
                // Just retag this window instead of making a new one!
                console.log(`[DISPATCH] Current window is new/empty. Retagging as ${targetTag} instead of moving.`);
                await setWindowTag(currentWindowId, targetTag);
            } else {
                console.log(`[DISPATCH] >> Creating NEW window for ${targetTag}`);
                const newWindow = await browser.windows.create({ tabId: tabId });
                await setWindowTag(newWindow.id, targetTag);
            }
        }

    } catch (e) {
        console.error("[DISPATCH] Error:", e);
    }
}

// --- LISTENERS ---

browser.tabs.onUpdated.addListener((tabId, changeInfo, tab) => {
    if (changeInfo.url) {
        dispatchTab(tabId, changeInfo.url);
    }
});

browser.tabs.onCreated.addListener((tab) => {
    if (tab.url && tab.url !== "about:blank") {
        dispatchTab(tab.id, tab.url);
    }
});

// CLEANUP: Remove tags when windows close
browser.windows.onRemoved.addListener((windowId) => {
    browser.storage.session.remove(`win_${windowId}`);
});